        "jsCode": "const items = $('Get Menu Items').all().map(i => i.json)\n  .filter(r => r && r.itemId && r.active !== false && r.active !== 'false')\n  .map(r => ({\n    id: r.itemId,\n    name: r.name,\n    price: Number(r.price),\n    category: r.category || '',\n    description: r.description || '',\n    imageUrl: r.imageUrl || '',\n    modelUrl: r.modelUrl || '',\n    modelStatus: r.modelStatus || 'none'\n  }));\nreturn [{ json: { success: true, items } }];"
      },
